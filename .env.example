# Runtime integrations remain disabled until privacy and consent requirements
# are confirmed. Never commit real credentials or private operational data.
# GROOVE PLAYLIST screens call the backend directly; point this at the API origin
# (path includes /api). Local dev may need the backend to allow http://localhost:5173.
VITE_API_BASE_URL=https://chcse.knu.ac.kr/groove/api
VITE_TELEMETRY_ENABLED=false
# 가요제 Google 로그인(AUTH-1)용 OAuth Client ID. 서버가 ID 토큰의 aud를 이
# 값과 대조하므로 백엔드와 항상 같은 값을 써야 한다. 비밀값이 아니라 프론트
# 번들에 그대로 노출돼도 되는 공개 식별자다 (백엔드팀 확인, 2026-09-23).
VITE_GOOGLE_CLIENT_ID=471913186950-g1bbh8tenk6aidbrsl2q0u5q9mb90ua2.apps.googleusercontent.com
VITE_GA_MEASUREMENT_ID=
VITE_SENTRY_DSN=
VITE_CLARITY_PROJECT_ID=

# Sentry build-only source-map upload settings. SENTRY_AUTH_TOKEN is secret and
# must never use a VITE_ prefix or be committed with a real value.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional outside Vercel/GitHub Actions, where the commit SHA is detected.
SENTRY_RELEASE=
