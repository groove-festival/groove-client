# Copy local values to .env.local. Never commit secrets or private operational data.
# VITE_ values are exposed in the browser; use the public OAuth client ID, never a client secret.
# GROOVE PLAYLIST screens call the backend directly; point this at the API origin
# (path includes /api). Local dev may need the backend to allow http://localhost:5173.
VITE_API_BASE_URL=https://chcse.knu.ac.kr/groove/api
# Google Cloud OAuth client type: Web application. Authorize http://localhost:5173
# and https://chcse.knu.ac.kr as JavaScript origins (no /groove path).
VITE_GOOGLE_CLIENT_ID=
VITE_TELEMETRY_ENABLED=false
VITE_GA_MEASUREMENT_ID=
VITE_SENTRY_DSN=
VITE_CLARITY_PROJECT_ID=

# Sentry build-only source-map upload settings. SENTRY_AUTH_TOKEN is secret and
# must never use a VITE_ prefix or be committed with a real value.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional outside Vercel/GitHub Actions, where the commit SHA is detected.
SENTRY_RELEASE=
